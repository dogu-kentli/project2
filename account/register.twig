{{ header }}

<div class="full-container main-container login-container" style="padding-top: 160px; padding-bottom: 80px; background-color: #fdfdfd;">
    <div class="container">
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
            
            <div class="row" style="display: flex; flex-wrap: wrap; align-items: center;"> 
                
                <div class="col-lg-12 col-md-12 hidden-sm hidden-xs" style="padding: 0 15px;">
                    <img class="img-responsive" src="catalog/view/theme/default/image/login-img.png" alt="Giriş" style="width: 100%; border-radius: 10px;">
                </div>

                <div class="col-lg-12 col-md-12 col-sm-24 col-xs-24" style="padding: 0 15px;">
                    <div style="background: #ffffff; padding: 35px; border-radius: 12px; border: 1px solid #eee; box-shadow: 0 8px 20px rgba(0,0,0,0.02);">
                        
                        <div style="margin-bottom: 30px; border-bottom: 1px solid #eee;">
                            <ul class="nav nav-tabs" style="display: flex; border: none; justify-content: space-around; margin: 0;">
                                <li style="flex: 1; text-align: center;">
                                    <a href="{{ login }}" style="font-size: 16px; color: #bbb; border: none; padding-bottom: 12px; display: block; background: transparent;">Giriş Yap</a>
                                </li>
                                <li class="active" style="flex: 1; text-align: center; ">
                                    <a href="{{ register }}" style="font-size: 16px; color: #333; border: none; font-weight: 600; padding-bottom: 12px; display: block; background: transparent;">Üye Ol</a>
                                </li>
                            </ul>
                        </div>

                        <div class="login-form">
                            <!-- Ad ve Soyad -->
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label style="font-size: 13px; color: #666;">{{ entry_firstname }}</label>
                                        <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" class="form-control" style="height: 45px; border-radius: 6px;" />
                                        {% if error_firstname %}<div class="text-danger" style="font-size: 11px;">{{ error_firstname }}</div>{% endif %}
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label style="font-size: 13px; color: #666;">{{ entry_lastname }}</label>
                                        <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" class="form-control" style="height: 45px; border-radius: 6px;" />
                                        {% if error_lastname %}<div class="text-danger" style="font-size: 11px;">{{ error_lastname }}</div>{% endif %}
                                    </div>
                                </div>
                            </div>

                            <!-- E-posta ve Telefon Yan Yana -->
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label style="font-size: 13px; color: #666;">{{ entry_email }}</label>
                                        <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" class="form-control" style="height: 45px; border-radius: 6px;" />
                                        {% if error_email %}<div class="text-danger" style="font-size: 11px;">{{ error_email }}</div>{% endif %}
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label style="font-size: 13px; color: #666;">{{ entry_telephone }}</label>
                                        <input type="tel" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" class="form-control" style="height: 45px; border-radius: 6px;" />
                                        {% if error_telephone %}<div class="text-danger" style="font-size: 11px;">{{ error_telephone }}</div>{% endif %}
                                    </div>
                                </div>
                            </div>

                            <!-- Doğum Tarihi Alt Satırda -->
                            <div class="form-group">
                                <label style="font-size: 13px; color: #666;">Doğum Tarihi</label>
                                <input type="date" name="dogum_tarihi" value="{{ dogum_tarihi }}" class="form-control" style="height: 45px; border-radius: 6px;" />
                                {% if error_dogum %}<div class="text-danger" style="font-size: 11px;">{{ error_dogum }}</div>{% endif %}
                            </div>

                            <!-- Parola ve Parola Tekrarı -->
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label style="font-size: 13px; color: #666;">{{ entry_password }}</label>
                                        <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" class="form-control" style="height: 45px; border-radius: 6px;" />
                                        {% if error_password %}<div class="text-danger" style="font-size: 11px;">{{ error_password }}</div>{% endif %}
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label style="font-size: 13px; color: #666;">{{ entry_confirm }}</label>
                                        <input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" class="form-control" style="height: 45px; border-radius: 6px;" />
                                         {% if error_confirm %}<div class="text-danger" style="font-size: 11px;">{{ error_confirm }}</div>{% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group" style="margin: 25px 0;">
                                <div class="checkbox-wrapper" style="display: flex; align-items: flex-start; cursor: pointer;">
                                    <input type="checkbox" name="agree" value="1" id="agree-check" {% if agree %} checked {% endif %} style="width: 18px; height: 18px; margin: 0 10px 0 0; cursor: pointer; flex-shrink: 0; position: relative; z-index: 10;" /> 
                                    <label for="agree-check" style="font-size: 13px; color: #555; cursor: pointer; font-weight: normal; line-height: 18px; margin: 0;">
                                        {{ text_agree }}
                                    </label>
                                </div>
                                {% if error_warning %}<div class="text-danger" style="font-size: 11px; margin-top: 5px;">{{ error_warning }}</div>{% endif %}
                            </div>

                            {% if redirect %}
                                <input type="hidden" name="redirect" value="{{ redirect }}" />
                            {% endif %}

                            <button type="submit" class="btn btn-primary btn-block" style="height: 52px; font-size: 16px; font-weight: 600; background: #222; border: none; border-radius: 6px;">KAYDET</button>
                        </div>
                    </div>
                </div> 

            </div>
        </form>
    </div>
</div>
<style>
.text-danger {
    color: #dc3545;
    font-size: 1.5rem;
    margin-top: 5px;
}
</style>
{{ footer }}
<script>
$(document).ready(function() {
  $('.nav-tabs li').on('click', function() {
    var url = $(this).data('href');
    if (url) {
      window.location.href = url;
    }
  });
});
</script>
<script>
$(document).ready(function() {
  var error_warning = '{{error_warning}}';
    if (error_warning) {
      $('#alert').append('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i>' + error_warning + '</div>');
    }
});
</script>
<script>
var alert = function () {
    window.setTimeout(function () {
        $('.alert-dismissible').fadeTo(2000, 0, function () {
            $(this).remove();
        });
    }, 5000);
}
</script>
<script>
$('.text-agree').on('click', function() {
    $('#modal-information').show();
});
</script>

<div class="form-footer-spacer"></div>

<hr>
