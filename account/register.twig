{{ header }}

<div class="full-container main-container login-container" style="padding-top: 160px; padding-bottom: 80px; background-color: #fdfdfd;">
  <div class="container">
    <form action="{{ action }}" method="post" enctype="multipart/form-data">
      <div class="row" style="display:flex; flex-wrap:wrap; align-items:stretch;">
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="padding:0 15px;">
          <div style="height:100%; min-height:360px; background:#fff; padding:40px; border-radius:12px; border:1px solid #eee; box-shadow:0 8px 20px rgba(0,0,0,.02); display:flex; flex-direction:column; justify-content:center;">
            <h2 style="margin-top:0; color:#222;">E-posta doğrulama</h2>
            <p style="font-size:16px; line-height:1.8; color:#666;">Yeni kayıt oluşturduğunuzda e-posta adresinize bir aktivasyon kodu gönderilir.</p>
            <p style="font-size:16px; line-height:1.8; color:#666;">E-postanızı doğrulamak için gönderilen kodu bu formdaki aktivasyon alanına yazınız. Kod 15 dakika geçerlidir.</p>
            {% if activation_required %}
              <div style="margin-top:15px; padding:14px; background:#f6f8fa; border-radius:6px; color:#555;">Kod e-posta adresinize gönderildi. Gelen kutunuzu ve spam klasörünüzü kontrol ediniz.</div>
            {% endif %}
          </div>
        </div>

        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" style="padding:0 15px;">
          <div style="background:#fff; padding:35px; border-radius:12px; border:1px solid #eee; box-shadow:0 8px 20px rgba(0,0,0,.02);">
            <div style="margin-bottom:30px; border-bottom:1px solid #eee;">
              <ul class="nav nav-tabs" style="display:flex; border:none; justify-content:space-around; margin:0;">
                <li style="flex:1; text-align:center;"><a href="{{ login }}" style="font-size:16px; color:#bbb; border:none; padding-bottom:12px; display:block; background:transparent;">Giriş Yap</a></li>
                <li class="active" style="flex:1; text-align:center;"><a href="{{ register }}" style="font-size:16px; color:#333; border:none; font-weight:600; padding-bottom:12px; display:block; background:transparent;">Üye Ol</a></li>
              </ul>
            </div>

            {% if not activation_required %}
              <div class="row">
                <div class="col-sm-12"><div class="form-group"><label>{{ entry_firstname }}</label><input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" class="form-control" />{% if error_firstname %}<div class="text-danger">{{ error_firstname }}</div>{% endif %}</div></div>
                <div class="col-sm-12"><div class="form-group"><label>{{ entry_lastname }}</label><input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" class="form-control" />{% if error_lastname %}<div class="text-danger">{{ error_lastname }}</div>{% endif %}</div></div>
              </div>
              <div class="form-group"><label>Doğum Tarihi</label><input type="date" name="dogum_tarihi" value="{{ dogum_tarihi }}" class="form-control" />{% if error_dogum %}<div class="text-danger">{{ error_dogum }}</div>{% endif %}</div>
              <div class="form-group"><label>{{ entry_email }}</label><input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" class="form-control" />{% if error_email %}<div class="text-danger">{{ error_email }}</div>{% endif %}</div>
              <div class="form-group"><label>{{ entry_telephone }}</label><input type="tel" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" class="form-control" />{% if error_telephone %}<div class="text-danger">{{ error_telephone }}</div>{% endif %}</div>
              <div class="row"><div class="col-sm-12"><div class="form-group"><label>{{ entry_password }}</label><input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" class="form-control" />{% if error_password %}<div class="text-danger">{{ error_password }}</div>{% endif %}</div></div><div class="col-sm-12"><div class="form-group"><label>{{ entry_confirm }}</label><input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" class="form-control" />{% if error_confirm %}<div class="text-danger">{{ error_confirm }}</div>{% endif %}</div></div></div>
              <div class="form-group" style="margin:25px 0;"><label><input type="checkbox" name="agree" value="1" {% if agree %}checked{% endif %} /> {{ text_agree }}</label></div>
            {% else %}
              <div class="form-group" style="margin-top:20px;"><label for="activation-code">Aktivasyon Kodu</label><input id="activation-code" type="text" name="activation_code" value="{{ activation_code }}" placeholder="E-postanıza gelen 6 haneli kod" maxlength="6" inputmode="numeric" autocomplete="one-time-code" class="form-control" style="height:52px; font-size:20px; letter-spacing:4px; text-align:center;" autofocus />{% if error_activation_code %}<div class="text-danger">{{ error_activation_code }}</div>{% endif %}</div>
            {% endif %}

            {% if error_warning %}<div class="text-danger" style="margin:10px 0;">{{ error_warning }}</div>{% endif %}
            <button type="submit" class="btn btn-primary btn-block" style="height:52px; font-size:16px; font-weight:600; background:#222; border:none; border-radius:6px;">{% if activation_required %}KODU DOĞRULA VE KAYDI TAMAMLA{% else %}KAYIT OL{% endif %}</button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<style>
.form-control { height:45px; border-radius:6px; }
.form-group { margin-bottom:18px; }
.form-group label { font-size:13px; color:#666; display:block; margin-bottom:6px; }
.text-danger { color:#dc3545; font-size:13px; margin-top:5px; }
</style>
{{ footer }}
